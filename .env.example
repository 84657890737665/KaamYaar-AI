# Gemini API Key for AI service orchestration
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key for distance calculation and geocoding
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email@your_project.iam.gserviceaccount.com

# Cloud Run deployment URL
CLOUD_RUN_SERVICE_URL=https://your-cloud-run-url.run.app

# Application Port
PORT=8000